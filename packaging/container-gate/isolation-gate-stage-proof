#!/bin/sh
set -eu

[ "$#" -ge 4 ] || exit 64
[ "$(($# % 4))" -eq 0 ] || exit 64

state_directory=/tmp/local-agent-stage-proof
/bin/mkdir -p "$state_directory"
first=$(/bin/mktemp "$state_directory/manifest.XXXXXX")
second=$(/bin/mktemp "$state_directory/manifest.XXXXXX")
paths=$(/bin/mktemp "$state_directory/paths.XXXXXX")
sorted=$(/bin/mktemp "$state_directory/sorted.XXXXXX")

cleanup() {
    /bin/rm -f "$first" "$second" "$paths" "$sorted"
}
trap cleanup EXIT HUP INT TERM

write_manifest() {
    root=$1
    output=$2
    /usr/bin/find "$root" -mindepth 1 -print > "$paths"
    LC_ALL=C /usr/bin/sort "$paths" > "$sorted"
    /usr/bin/printf 'lca-workspace-snapshot-v1\n' > "$output"
    while IFS= read -r path; do
        relative=${path#"$root"/}
        encoded=$(
            /usr/bin/printf '%s' "$relative" \
                | /bin/base64 \
                | /usr/bin/tr -d '\n'
        )
        mode=$(/bin/stat -c '%a' -- "$path")
        if [ -L "$path" ]; then
            exit 74
        elif [ -d "$path" ]; then
            /usr/bin/printf 'd\t%s\t%s\n' "$mode" "$encoded" >> "$output"
        elif [ -f "$path" ]; then
            [ "$(/bin/stat -c '%h' -- "$path")" -eq 1 ] || exit 74
            size=$(/bin/stat -c '%s' -- "$path")
            digest=$(/usr/bin/sha256sum "$path" | /usr/bin/cut -d ' ' -f 1)
            /usr/bin/printf 'f\t%s\t%s\t%s\t%s\n' \
                "$mode" "$size" "$digest" "$encoded" >> "$output"
        else
            exit 74
        fi
    done < "$sorted"
}

while [ "$#" -gt 0 ]; do
    [ "$1" = "--root" ] || exit 64
    root=$2
    [ "$3" = "--manifest-sha256" ] || exit 64
    expected=$4
    shift 4

    [ -d "$root" ] || exit 75
    [ "${#expected}" -eq 64 ] || exit 64
    case "$expected" in
        *[!0-9a-f]*) exit 64 ;;
    esac

    write_manifest "$root" "$first"
    write_manifest "$root" "$second"
    /usr/bin/cmp -s "$first" "$second" || exit 75
    observed=$(/usr/bin/sha256sum "$first" | /usr/bin/cut -d ' ' -f 1)
    [ "$observed" = "$expected" ] || exit 75
done
