{
  "id": "small-code-change-test-diff",
  "title": "Small code change with preview, test, and diff",
  "prompt": "修复 src/math.py 中 subtract 的计算错误。修改前必须 read_file，先 dry_run 预览，再 apply_patch 写入；随后运行完整测试命令 `PYTHONPATH=. python3 -m unittest tests.test_math` 并 git_diff。最后说明修改、测试和 diff。",
  "workspace_files": {
    "src/math.py": "def subtract(a, b):\n    return a + b\n",
    "tests/test_math.py": "import unittest\n\nfrom src.math import subtract\n\n\nclass MathTests(unittest.TestCase):\n    def test_subtract(self):\n        self.assertEqual(subtract(3, 1), 2)\n\n\nif __name__ == '__main__':\n    unittest.main()\n"
  },
  "initialize_git": true,
  "scripted_responses": [
    {
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "src/math.py"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "apply_patch",
          "arguments": {
            "path": "src/math.py",
            "tag": "{{hash:src/math.py}}",
            "start_line": 2,
            "end_line": 2,
            "old_text": "    return a + b",
            "new_text": "    return a - b",
            "mode": "replace",
            "dry_run": true
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "apply_patch",
          "arguments": {
            "path": "src/math.py",
            "tag": "{{hash:src/math.py}}",
            "start_line": 2,
            "end_line": 2,
            "old_text": "    return a + b",
            "new_text": "    return a - b",
            "mode": "replace"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "run_tests",
          "arguments": {
            "command": "PYTHONPATH=. python3 -m unittest tests.test_math"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "git_diff",
          "arguments": {}
        }
      ]
    },
    {
      "content": "已修改 src/math.py：subtract 现在返回 a - b。已运行 tests.test_math，结果通过；git_diff 仅显示 src/math.py 的这一行修复。"
    }
  ],
  "acceptance": {
    "required_tools": [
      "read_file",
      "apply_patch",
      "run_tests",
      "git_diff"
    ],
    "changed_files": [
      "src/math.py"
    ],
    "file_contains": {
      "src/math.py": "return a - b"
    },
    "answer_contains": [
      "tests.test_math"
    ],
    "requires_test_evidence": true,
    "max_tool_errors": 0,
    "command": "PYTHONPATH=. python3 -m unittest tests.test_math"
  },
  "residual_risk": "This evaluates a controlled anchored edit; it does not prove model selection quality for an ambiguous change."
}
