{
  "id": "readonly-exact-toolchoice",
  "title": "Read-only owner exploration treats search candidates as soft read hints",
  "prompt": "只读分析当前服务 owner、调用链和影响范围，不要修改文件。",
  "budget_seconds": 90,
  "workspace_files": {
    "src/Owner.java": "class CandidateOwner { void handle() {} }\n"
  },
  "scripted_responses": [
    {
      "tool_calls": [
        {
          "name": "search_code",
          "arguments": {
            "path": "src",
            "pattern": "CandidateOwner"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "search_code",
          "arguments": {
            "path": "src",
            "pattern": "detour"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "_invalid_arguments": "<tool_call><function=list_files></function></tool_call>"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "search_code",
          "arguments": {
            "path": "src",
            "pattern": "second detour"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "read_file",
          "arguments": {
            "path": "src/Owner.java"
          }
        }
      ]
    },
    {
      "content": "源码事实：src/Owner.java 已直接读取。待确认：真实 owner 仍需要调用链或路由绑定证据，不把同名类当作已证实 owner。"
    },
    {
      "tool_calls": [
        {
          "name": "submit_read_only_review",
          "arguments": {
            "verdict": "pass",
            "confidence": 0.95,
            "reason": "detour was suppressed and the direct read evidence boundary is honest"
          }
        }
      ]
    }
  ],
  "acceptance": {
    "required_tools": [
      "search_code",
      "read_file"
    ],
    "forbidden_tools": [
      "apply_patch",
      "write_file",
      "shell",
      "run_tests",
      "glob_files"
    ],
    "changed_files": [],
    "answer_all_of": [
      "src/Owner.java",
      "待确认",
      "调用链"
    ],
    "answer_forbidden_regex": [
      "(?:是|为)已证实 owner",
      "detour"
    ],
    "termination_reason": "final",
    "run_summary": {
      "tool_calls": 5,
      "tool_errors": 1,
      "suppressed_tool_executions": 0
    },
    "tool_choice_exact": {
      "forces": 0,
      "exhausted": 0
    },
    "read_only_reviewer": {
      "triggers": 1,
      "typed_submits": 1
    },
    "max_tool_errors": 1
  },
  "residual_risk": "The fixture proves that read-only semantic candidates remain soft hints: extra precise searches can continue, invalid reads are bounded, and a later direct read is still required before review."
}
